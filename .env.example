# Copy this file to .env locally. Never commit your actual .env or share tokens.
# Read-only official X API Bearer Token. Leave blank for Demo Mode.
X_BEARER_TOKEN=
# Keep false while your X balance is $0. No network access until explicitly true.
X_LIVE_ENABLED=false
# Default is local templates. Optional existing generative content provider:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
